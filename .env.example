# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

APP_URL="http://localhost:3000"

# ── Google OAuth 2.0 ──────────────────────────────────────────────
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_ADMIN_EMAILS="admin@example.com"

# ── SMS OTP (sms4free.co.il) ──────────────────────────────────────
SMS4FREE_KEY=
SMS4FREE_USER=
SMS4FREE_PASS=
SMS4FREE_SENDER=ChainSign
SMS_BRAND_NAME=ASA
SMS_ADMIN_PHONES=0546407363
SMS_OTP_TEST_MODE=true

JWT_SECRET="change-me-to-a-long-random-secret"

# ── Firebase ──────────────────────────────────────────────────────
VITE_USE_FIREBASE=false
VITE_USE_FIREBASE_AUTH=false
VITE_USE_FIRESTORE=false
VITE_USE_FIREBASE_STORAGE=false
VITE_USE_FIREBASE_EMULATORS=false
VITE_CLUB_ID=asa-tlv

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=chainsign-hr
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

CLUB_ID=asa-tlv
FIREBASE_PROJECT_ID=chainsign-hr
FIREBASE_STORAGE_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

DISABLE_LOCAL_DATA_API=false

# ── Production (.env.production) ──────────────────────────────────
# VITE_USE_FIREBASE=true
# VITE_USE_FIREBASE_EMULATORS=false
# DISABLE_LOCAL_DATA_API=true
# + all VITE_FIREBASE_* and VITE_GOOGLE_CLIENT_ID
# Deploy: npm run deploy:prod
#
# Secrets:
#   npx -y firebase-tools@latest functions:secrets:set SMS4FREE_KEY
#   npx -y firebase-tools@latest functions:secrets:set SMS4FREE_USER
#   npx -y firebase-tools@latest functions:secrets:set SMS4FREE_PASS
#   npx -y firebase-tools@latest functions:secrets:set SMS4FREE_SENDER
#   npx -y firebase-tools@latest functions:secrets:set JWT_SECRET
#   npx -y firebase-tools@latest functions:secrets:set RESEND_API_KEY
